{
  "name": "murafiq-pro",
  "version": "1.0.0",
  "description": "Murafiq Pro - Omra trips manager",
  "author": "Zied Bechawech",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64 --publish never" },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" },
  "build": {
    "appId": "tn.ennour.murafiqpro",
    "productName": "Murafiq Pro",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": { "target": [ { "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] } ], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "مرافق برو", "artifactName": "MurafiqPro-Setup-${version}.${ext}" },
    "portable": { "artifactName": "MurafiqPro-Portable-${version}.${ext}" }
  }
}
